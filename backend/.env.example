# ===========================================
# AgriSense Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------- MongoDB ----------
# Get a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/farmers_assistant?retryWrites=true&w=majority

# ---------- AI Services ----------
# Google Gemini API key (PRIMARY AI) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face token (BACKUP for plant disease detection) — https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ---------- Auth ----------
# Secret for signing JWT tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# ---------- Server ----------
PORT=3001
NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---------- Seed Data (optional) ----------
# SEED_OFFICER_EMAIL=officer@example.com
# SEED_OFFICER_PASSWORD=password123
